# Copy to backend/.env for local development, and set the same keys in Vercel
# for a deployment. See DEPLOY_CLINIC.md for what each one does.
#
# Never commit the real .env — it is gitignored.

# --- Required ---
MONGODB_URI=
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Comma-separated. Anything not listed is refused by CORS.
ALLOWED_ORIGINS=http://localhost:5173,https://zenoradental.whitefoxofficial.space
FRONTEND_URL=https://zenoradental.whitefoxofficial.space

# --- Clinic identity (appears in patient emails) ---
CLINIC_NAME=Zenora Dental
CLINIC_PHONE=
CLINIC_EMAIL=
CLINIC_FROM_ADDRESS=
# Leave EMPTY unless it is a real Google review link. When unset, the review
# section is omitted from the "visit completed" email rather than sending a dead link.
CLINIC_REVIEW_URL=
CLINIC_ID=default

# --- Email delivery ---
# Set SMTP_USER=resend to send via the Resend HTTP API with SMTP_PASS as the API key.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_FROM_EMAIL=
EMAIL_ASSET_BASE_URL=

# --- Optional ---
SENTRY_DSN=
SEED_ADMIN_EMAIL=admin@zenoradental.com
LOGIN_RATE_LIMIT=5
BOOKING_RATE_LIMIT=10
# Shared secret for the POST /api/inbound mail webhook. Set this; the route is
# otherwise reachable by anyone.
INBOUND_WEBHOOK_SECRET=
