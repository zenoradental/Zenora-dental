# Copy to ZENORA ADMIN/.env.local for local development, and set the same keys in
# Vercel for a deployment. See DEPLOY_CLINIC.md.
#
# WARNING: Vite inlines every VITE_* value into the public JavaScript bundle at
# build time. They are readable by anyone who loads the page. Never put a secret
# behind the VITE_ prefix. Changing one requires a rebuild, not just a restart.

# Backend origin. Set this per clinic.
VITE_API_BASE_URL=https://zenora-backend-black.vercel.app

# While true, the Analytics tab shows a "SAMPLE DATA — NOT YOUR REVENUE" banner.
# Defaults to true when unset. Set to false only once this instance holds real
# patient records, then rebuild.
VITE_ANALYTICS_DEMO_MODE=true

# Optional error reporting.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
